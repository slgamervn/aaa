# Public values: safe to expose only as NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only keys. Never use NEXT_PUBLIC_ for these.
SUPABASE_SECRET_KEY=

# Comma-separated email allowlist for GameVault administrator accounts.
# Each email must also exist as a user in Supabase Auth.
GAMEVAULT_ADMIN_EMAILS=

# Fine-grained GitHub token with Contents: Read and write on the target repo.
# Publishing remains disabled until this is set.
GITHUB_TOKEN=
GITHUB_PUBLISH_REPO=slgamervn/aaa
GITHUB_PUBLISH_BRANCH=main
